<?xml version="1.0" encoding="utf-8"?>
<!-- The laptop serves plain HTTP/WebSocket on the local network (no TLS), so cleartext must be allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
